# Token del bot, sacado del Discord Developer Portal
DISCORD_TOKEN=tu_token_aqui

# Ruta al archivo JSON de la cuenta de servicio de Google (uso local)
GOOGLE_CREDS_FILE=credentials.json

# Alternativa para Railway/producción: pega aquí el contenido completo del
# credentials.json en una sola línea. Si está presente, tiene prioridad sobre
# GOOGLE_CREDS_FILE. Déjala vacía o comentada si vas a usar el archivo local.
# GOOGLE_CREDS_JSON={"type":"service_account","project_id":"...", ...}

# ID de la Google Sheet (está en la URL: docs.google.com/spreadsheets/d/AQUI_EL_ID/edit)
SHEET_ID=tu_sheet_id_aqui

# Nombre de la pestaña/hoja donde están las partidas
SHEET_TAB=Partidas

# Nombre del rol de Discord que puede usar /registrar (además de administradores)
ADMIN_ROLE_NAME=Staff
